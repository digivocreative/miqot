# OpenAI API key for AI Copywriting feature
OPENAI_API_KEY=your-openai-api-key-here

# Background schedulers/notifiers are disabled by default outside production.
# Set ENABLE_BACKGROUND_JOBS=true only on the single server allowed to send Telegram broadcasts.
NODE_ENV=development
ENABLE_BACKGROUND_JOBS=false

# Keep AWAPI background sync enabled but skip automatic legacy jamaah sync/fallback.
# Manual legacy sync paths remain available for targeted recovery.
DISABLE_LEGACY_BACKGROUND_SYNC=false

# Emergency brake for all automatic jamaah sync loops (AWAPI + legacy).
# Other background jobs, notifier, and public APIs can keep running.
DISABLE_JAMAAH_BACKGROUND_SYNC=false

# AWAPI jamaah background cadence. Keep these high enough to avoid sustained DB write IO.
SYNC_COOLDOWN_MINUTES=60
HAJI_AWAPI_SYNC_COOLDOWN_MINUTES=60

# 32-byte base64 key for encrypting Meta CAPI access tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CAPI_ENCRYPTION_KEY=your-32-byte-base64-key-here

# Supabase (required for agent data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here

# AirLabs API key for real-time flight tracking (free tier: 1000 req/month)
AIRLABS_API_KEY=your-airlabs-api-key-here

# Internal Alhijaz API base URL (untuk local dev via SSH tunnel, set ke http://localhost:8220)
INTERNAL_API_BASE=http://115.124.86.220

# Public calendar transport. Primary tetap hostname TLS resmi; origin ini hanya
# dipakai saat WAF primary menolak egress server. Kosongkan untuk mematikan failover.
CALENDAR_PUBLIC_FALLBACK_ORIGIN_IP=115.124.86.220
CALENDAR_PUBLIC_FALLBACK_DETAIL_CONCURRENCY=1
# Reader relay is used only to recover current MUTAWIF values for upcoming
# departures when the VPS receives 403 from the primary calendar origin.
CALENDAR_PUBLIC_READER_BASE_URL=https://r.jina.ai
# Covers all normally published departures for the next six months. Requests
# remain serialized by CALENDAR_PUBLIC_READER_MIN_INTERVAL_MS.
CALENDAR_PUBLIC_MUTAWIF_READER_DAYS=180
CALENDAR_PUBLIC_READER_MIN_INTERVAL_MS=3200
CALENDAR_PUBLIC_ORIGIN_COOLDOWN_MS=1800000
CALENDAR_PUBLIC_TRANSIENT_COOLDOWN_MS=60000
CALENDAR_PRIMARY_REPROBE_MINUTES=30
CALENDAR_PUBLIC_MIN_EVENT_COUNT=20
CALENDAR_PUBLIC_REQUIRED_EVENT_TYPES=manasik,keberangkatan,kepulangan
CALENDAR_PUBLIC_MAX_STALE_DELETE_RATIO=0.25

# Telegram bot/notifier
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_URL=https://alhijaz.co/api/telegram/webhook
TELEGRAM_CHAT_ID=your-production-chat-id
TELEGRAM_CHAT_ID_DEV=your-dev-chat-id

# Bunny CDN Storage (for itinerary & brosur files)
BUNNY_STORAGE_API_KEY=your-bunny-storage-api-key
BUNNY_STORAGE_ZONE=your-storage-zone-name
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_CDN_HOSTNAME=your-pullzone.b-cdn.net

# Sentry DSN untuk error tracking (optional — jika kosong, Sentry tidak aktif)
SENTRY_DSN=

# Public IP server VPS (untuk fitur custom domain — agent point A record ke IP ini)
# Cek di server: curl ifconfig.me
VPS_PUBLIC_IP=

# Dev-MCP (MCP developer-tool /dev-mcp untuk brainstorming di claude.ai)
# DEV_MCP_PASSWORD wajib untuk MENGAKTIFKAN endpoint (kosong = nonaktif).
# DEV_MCP_SECRET opsional (kalau kosong, diturunkan dari JWT_SECRET secara aman).
# DEV_MCP_BLOCK_GLOBS opsional: glob dipisah koma untuk menyembunyikan dokumen tertentu.
DEV_MCP_PASSWORD=
DEV_MCP_SECRET=
DEV_MCP_BLOCK_GLOBS=

# Resend (email transactional: reset password; + email alias agent slug@alhijaz.co)
# RESEND_API_KEY: API key dari resend.com (domain alhijaz.co harus verified).
# RESEND_WEBHOOK_SECRET: signing secret webhook `email.received` (whsec_...) —
#   wajib untuk fitur email alias forwarding; kosong = fitur alias nonaktif.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
