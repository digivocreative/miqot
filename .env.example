# OpenAI API key for AI Copywriting feature
OPENAI_API_KEY=your-openai-api-key-here

# 32-byte base64 key for encrypting Meta CAPI access tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CAPI_ENCRYPTION_KEY=your-32-byte-base64-key-here

# Supabase (required for agent data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here

# AirLabs API key for real-time flight tracking (free tier: 1000 req/month)
AIRLABS_API_KEY=your-airlabs-api-key-here

# Internal Alhijaz API base URL (untuk local dev via SSH tunnel, set ke http://localhost:8220)
INTERNAL_API_BASE=http://115.124.86.220

# Sentry DSN untuk error tracking (optional — jika kosong, Sentry tidak aktif)
SENTRY_DSN=
